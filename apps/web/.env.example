# Env for the Next.js app (dev server, API routes). Mirrors the root .env.example —
# duplicate here if you're running apps/web standalone (e.g. deploying just this app).

# Database (Supabase Postgres connection string)
DATABASE_URL=

# Google OAuth
GOOGLE_OAUTH_CLIENT_IDS=
GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Google Gemini (listing condition analysis)
GOOGLE_GEMINI_API_KEY=

# Supabase (storage, service-role access)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Embedding-based shoe match search
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
BASELINE_MATCH_THRESHOLD=

# Sneaker scraper source site
SCRAPE_SITE=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public app URL (used in emails, redirects)
NEXT_PUBLIC_APP_URL=
