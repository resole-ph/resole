# Env for the Expo app

# API base URL for the mobile client (points at the deployed web app)
EXPO_PUBLIC_API_URL=

# Google OAuth
GOOGLE_OAUTH_CLIENT_IDS= # comma-separated list of additional allowed client IDs
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Supabase (storage URL only — no service-role key on the client)
NEXT_PUBLIC_SUPABASE_URL=
