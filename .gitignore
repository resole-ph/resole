# Root ignore rules for the monorepo

# dependencies
node_modules/

# testing
coverage/

# next.js
.next/
out/

# production
build/

# expo / react native
.expo/
dist/
web-build/

# native outputs
ios/
android/
.kotlin/

# generated files
expo-env.d.ts
next-env.d.ts
*.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
npm-debug.*
yarn-debug.*
yarn-error.*

# env files
.env*
!.env.example

# vercel
.vercel/

# supabase cli local state
supabase/.temp/

# misc
.DS_Store
*.pem
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# yarn berry
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions