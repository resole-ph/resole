# Root env — loaded by web scripts that run outside the Next.js dev server
# (Drizzle migrations/generate, the sneaker scraper). See apps/web/.env.example
# for the vars the Next.js app itself reads, and apps/mobile/.env.example for Expo.

# Database (Supabase Postgres connection string)
DATABASE_URL=

# Google OAuth
GOOGLE_OAUTH_CLIENT_IDS= # comma-separated list of additional allowed client IDs
GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Google Gemini (listing condition/authenticity analysis, embedding search)
GOOGLE_GEMINI_API_KEY=

# Supabase (storage, service-role access)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Embedding-based shoe match search
EMBEDDING_MODEL= # defaults to gemini-embedding-001 if unset
EMBEDDING_DIMENSIONS= # defaults to 1536 if unset
BASELINE_MATCH_THRESHOLD= # minimum cosine similarity for a match; defaults to 0.75 if unset

# Sneaker scraper source site
SCRAPE_SITE=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public app URL (used in emails, redirects)
NEXT_PUBLIC_APP_URL=
